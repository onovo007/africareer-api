# Copy to .env for local runs. In production set these in the host's dashboard, never in git.
OPENAI_API_KEY=sk-...
PINECONE_API_KEY=...
TAVILY_API_KEY=tvly-...            # optional: enables live job/opportunity/org research
API_AUTH_TOKEN=                    # optional: if set, callers must send header X-API-Key: <token>
FRONTEND_ORIGIN=http://localhost:3000,https://africareer.quantiuminsights.com

# Optional analytics and protected admin (server-side only)
SUPABASE_URL=
SUPABASE_KEY=
ADMIN_TOKEN=

# Pinned document generation and review model; changing this requires acceptance tests
GENERAL_MODEL=gpt-6-sol
DOCUMENT_MODEL=gpt-6-sol
# Explicit doctoral application drafts and their factual review
DOCTORAL_MODEL=gpt-6-astra
